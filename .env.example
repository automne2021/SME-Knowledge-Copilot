# Sao chép thành .env và chỉnh giá trị. Không commit file .env.

# PostgreSQL (docker compose)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=copilot

# Cổng host của Compose (compose.yaml). Đổi khi chạy song song một bản cài khác.
DB_HOST_PORT=5433
QDRANT_HOST_PORT=6333

# API/worker chạy trên máy host, kết nối qua cổng DB_HOST_PORT.
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@127.0.0.1:5433/copilot
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@127.0.0.1:5433/copilot_test

FILE_STORAGE_DIR=storage
# STORAGE_DIR is a legacy alias; FILE_STORAGE_DIR takes precedence when both exist.
MAX_UPLOAD_MB=20
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Qdrant: host profile. Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_e5_small_v1

# E5 CPU profile: local ingestion Step 06 and search Step 07; frozen dev baseline in eval/configs/dense.json.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
MAX_PDF_PAGES=200
MAX_DOCX_UNCOMPRESSED_MB=100
MAX_DOCX_ZIP_ENTRIES=2000
PARSER_TIMEOUT_SECONDS=60
MAX_EXTRACTED_CHARS=2000000
MAX_SOURCE_BLOCKS=20000
MAX_DOCUMENT_CHUNKS=5000
EMBEDDING_THREADS=2
EMBEDDING_TIMEOUT_SECONDS=120
VECTOR_TIMEOUT_SECONDS=10
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=15
JOB_BACKOFF_SECONDS=5
JOB_BACKOFF_CAP_SECONDS=60
WORKER_POLL_SECONDS=2
WORKER_SWEEP_SECONDS=60
ORPHAN_GRACE_SECONDS=3600
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5
# Empty means disabled; only set a cutoff after dev calibration.
RETRIEVAL_SCORE_THRESHOLD=

# Cache theo project. Dùng đường dẫn TUYỆT ĐỐI để API (cwd backend/) và eval (cwd root) cùng thấy.
# Ví dụ: C:/path/to/repo/.cache/huggingface. E5 phải có sẵn trong HF_HOME; runtime không tự tải.
HF_HOME=<absolute-repo-path>/.cache/huggingface
PIP_CACHE_DIR=<absolute-repo-path>/.cache/pip
NPM_CONFIG_CACHE=<absolute-repo-path>/.cache/npm

# Workspace policy: free tier only, maximum model spend 0 USD. No paid fallback.
# Native Gemini adapter. Flags are manual attestations, not provider billing caps.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_FREE_TIER_CONFIRMED=false
LLM_QUOTA_CONFIRMED=false

# Demo auth: generate private, different passwords; never commit real values.
AUTH_TOKEN_TTL_SECONDS=3600
DEMO_ADMIN_PASSWORD=
DEMO_MEMBER_PASSWORD=

# Step 08 answering. Context ceiling is an app cap, below model's input limit.
LLM_EVIDENCE_BUDGET_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=800
LLM_SAFETY_MARGIN_TOKENS=256
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_CALL_TIMEOUT_SECONDS=60
QUERY_TIMEOUT_SECONDS=150
LLM_MAX_CONCURRENCY=2
