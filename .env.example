# Sao chép thành .env và chỉnh giá trị. Không commit file .env.

# PostgreSQL (docker compose)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=copilot

# Backend chạy trên máy host kết nối qua cổng 5433 (xem compose.yaml)
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@localhost:5433/copilot
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@localhost:5433/copilot_test

FILE_STORAGE_DIR=storage
# STORAGE_DIR is a legacy alias; FILE_STORAGE_DIR takes precedence when both exist.
MAX_UPLOAD_MB=20
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Qdrant: host profile. Compose overrides this with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_e5_small_v1

# Candidate model configuration for later smoke tests (no download in Step 01).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# Windows project-only cache location; adapt paths on another machine.
HF_HOME=D:/AI-Cache/sme-copilot/huggingface
PIP_CACHE_DIR=D:/AI-Cache/sme-copilot/pip
NPM_CONFIG_CACHE=D:/AI-Cache/sme-copilot/npm

# Workspace policy: free tier only, maximum model spend 0 USD. No paid fallback.
# Hosted LLM adapter: configure privately before Step 03. Never commit a real key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Parser/worker/auth/LLM budget settings are added with their implementation.
