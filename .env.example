# Sao chép thành .env và chỉnh giá trị. Không commit file .env.

# PostgreSQL (docker compose)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=copilot

# Backend chạy trên máy host kết nối qua cổng 5433 (xem compose.yaml)
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@localhost:5433/copilot
TEST_DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@localhost:5433/copilot_test

STORAGE_DIR=storage
MAX_UPLOAD_MB=25
APP_TIMEZONE=Asia/Ho_Chi_Minh

# LLM hosted, OpenAI-compatible (ADR-02)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# faster-whisper model size: tiny | base | small | medium | large-v3
STT_MODEL=small

# M2
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
